# Public site origin (used for canonical URLs, sitemap and OpenGraph)
NEXT_PUBLIC_SITE_URL=https://elsewhere.example

# Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# "true" once Google is enabled under Auth → Providers in Supabase
NEXT_PUBLIC_AUTH_GOOGLE=false

# Optional. The footer links out only when this is set.
NEXT_PUBLIC_INSTAGRAM_URL=
